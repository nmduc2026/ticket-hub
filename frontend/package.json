    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "i18next": "^26.5.3",
    "konva": "^10.9.0",
    "lucide-react": "^1.60.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.90.0",
    "react-i18next": "^17.1.0",
    "react-konva": "^19.3.2",
