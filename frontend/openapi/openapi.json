{
  "openapi" : "3.1.0",
  "info" : {
    "title" : "Ticket Hub API",
    "version" : "v1"
  },
  "servers" : [ {
    "url" : "http://localhost",
    "description" : "Generated server url"
  } ],
  "paths" : {
    "/api/v1/me" : {
      "get" : {
        "tags" : [ "me-controller" ],
        "summary" : "Hồ sơ và role của người đang đăng nhập",
        "operationId" : "getMe",
        "responses" : {
          "200" : {
            "description" : "Hồ sơ người dùng",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/MeResponse"
                }
              }
            }
          },
          "401" : {
            "description" : "Chưa đăng nhập (UNAUTHENTICATED)",
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            }
          }
        }
      }
    }
  },
  "components" : {
    "schemas" : {
      "MeResponse" : {
        "type" : "object",
        "properties" : {
          "id" : {
            "type" : "string",
            "format" : "uuid"
          },
          "email" : {
            "type" : [ "string", "null" ]
          },
          "fullName" : {
            "type" : [ "string", "null" ]
          },
          "username" : {
            "type" : [ "string", "null" ]
          },
          "roles" : {
            "type" : "array",
            "items" : {
              "type" : "string"
            }
          },
          "enabled" : {
            "type" : "boolean"
          }
        },
        "required" : [ "email", "enabled", "fullName", "id", "roles", "username" ]
      },
      "ProblemDetail" : {
        "type" : "object",
        "properties" : {
          "type" : {
            "type" : "string",
            "format" : "uri"
          },
          "title" : {
            "type" : "string"
          },
          "status" : {
            "type" : "integer",
            "format" : "int32"
          },
          "detail" : {
            "type" : "string"
          },
          "instance" : {
            "type" : "string",
            "format" : "uri"
          },
          "properties" : {
            "type" : "object",
            "additionalProperties" : { }
          }
        }
      }
    }
  }
}
