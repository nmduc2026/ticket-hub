# Sao chép thành .env.local (đã gitignore). Chỉ khoá công khai; không đặt secret ở đây (Vite đưa VITE_* vào bundle).

# Khoá publishable test mode (pk_test_…) cho Stripe Payment Element; để trống thì checkout báo chưa cấu hình thanh toán
VITE_STRIPE_PUBLISHABLE_KEY=
# Trang tài khoản Keycloak (đổi email, mật khẩu)
VITE_KEYCLOAK_ACCOUNT_URL=http://localhost:8180/realms/tickethub/account
# DSN Sentry (để trống: không gửi lỗi)
VITE_SENTRY_DSN=
