# Sao chép thành .env (đã gitignore) rồi chạy: docker compose --profile core up -d
# Mọi giá trị dưới đây chỉ là giá trị giả cho máy dev, không dùng ở môi trường khác.

# Postgres: một database `tickethub`, mỗi module một schema
POSTGRES_DB=tickethub
POSTGRES_USER=tickethub
POSTGRES_PASSWORD=123123
POSTGRES_PORT=5432

# Redis
REDIS_PASSWORD=123123
REDIS_PORT=6379

# Keycloak (database `keycloak` nằm cùng server Postgres)
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=123123
KEYCLOAK_PORT=8180
# Client secret của realm tickethub (infra/keycloak/tickethub-realm.json đọc qua ${...})
KEYCLOAK_BFF_CLIENT_SECRET=123123
KEYCLOAK_INTERNAL_CLIENT_SECRET=123123
KEYCLOAK_ACCOUNT_ADMIN_CLIENT_SECRET=123123

# Mailpit
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# stripe-mock (profile loadtest): chỉ bật khi load test / chaos, kèm STRIPE_API_BASE=http://localhost:12111
STRIPE_MOCK_PORT=12111

# ---- Biến cho app khi chạy ./mvnw -pl app spring-boot:run (app không chạy trong compose dev) ----
# spring-boot:run tự đọc file này (spring.config.import trong pom của app / gateway), không cần nạp vào shell.
DB_PASSWORD=123123
# Ảnh banner / avatar: bucket S3 thật, dùng chung cho dev và staging. Lấy giá trị bằng
# `terraform output` trong infra/terraform/aws/media (secret_key: `terraform output -raw storage_secret_key`).
STORAGE_BUCKET=
STORAGE_PUBLIC_BASE_URL=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
# Stripe test mode thật: Dashboard → Developers → API keys (sk_test_…). Để trống STRIPE_API_BASE (gọi api.stripe.com)
STRIPE_API_BASE=
STRIPE_SECRET_KEY=
# Lấy từ `stripe listen --forward-to localhost:8080/api/v1/webhooks/stripe` khi dùng Stripe test thật
STRIPE_WEBHOOK_SECRET=
# Endpoint Connect (account.updated) có signing secret riêng: stripe listen --forward-connect-to …/api/v1/webhooks/stripe-connect
STRIPE_CONNECT_WEBHOOK_SECRET=
# Khoá ký QR ES256 (JWK JSON có khoá riêng và kid). Để trống: app sinh khoá tạm, vé cũ không xác minh được sau khi
# khởi động lại. Cách sinh khoá: docs/runbooks/rotate-ticket-signing-key.md.
TICKET_SIGNING_JWK=
# Gửi email qua Mailpit ở trên
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=Ticket Hub <no-reply@tickethub.local>
WEB_BASE_URL=http://localhost:5173
