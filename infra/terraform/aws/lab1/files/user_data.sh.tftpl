#!/bin/bash
# Khởi động EC2 lab 1: cài Docker, tải cấu hình từ S3 + SSM, dựng database, chạy Docker Compose.
# Log: /var/log/tickethub-bootstrap.log. Không in secret ra log.
set -euo pipefail
exec > >(tee /var/log/tickethub-bootstrap.log) 2>&1

export AWS_DEFAULT_REGION="${region}"
dir=/opt/tickethub

echo "== Swap 2 GB (phòng thiếu RAM khi Keycloak khởi động) =="
fallocate -l 2G /swapfile
chmod 600 /swapfile
mkswap /swapfile
swapon /swapfile

echo "== Docker + Compose =="
dnf install -y docker jq
systemctl enable --now docker
mkdir -p /usr/local/lib/docker/cli-plugins
curl -fsSL "https://github.com/docker/compose/releases/download/v2.40.3/docker-compose-linux-x86_64" \
  -o /usr/local/lib/docker/cli-plugins/docker-compose
chmod +x /usr/local/lib/docker/cli-plugins/docker-compose

ssm() { aws ssm get-parameter --name "/${name}/$1" --with-decryption --query Parameter.Value --output text; }

echo "== Chờ địa chỉ công khai (CloudFront) =="
public_url=""
for _ in $(seq 1 90); do
  if public_url="$(ssm public-url 2>/dev/null)"; then
    break
  fi
  sleep 10
done
if [ -z "$public_url" ]; then
  echo "Không có tham số public-url sau 15 phút" >&2
  exit 1
fi

echo "== Tải cấu hình =="
mkdir -p "$dir/realm" "$dir/themes"
aws s3 cp "s3://${artifacts}/compose.yaml" "$dir/compose.yaml"
aws s3 cp "s3://${artifacts}/nginx.conf" "$dir/nginx.conf"
aws s3 sync "s3://${artifacts}/themes" "$dir/themes"
aws s3 cp "s3://${artifacts}/tickethub-realm.json" "$dir/realm-src.json"

# Realm export chỉ có địa chỉ localhost: thêm địa chỉ CloudFront cho client BFF.
jq --arg url "$public_url" '
  .clients |= map(
    if .clientId == "tickethub-bff" then
      .redirectUris += [$url + "/login/oauth2/code/keycloak"]
      | .attributes["post.logout.redirect.uris"] += "##" + $url + "/*"
    else . end)' "$dir/realm-src.json" > "$dir/realm/tickethub-realm.json"
rm "$dir/realm-src.json"

echo "== Secret và biến môi trường (.env, chỉ root đọc được) =="
umask 077
cat > "$dir/.env" <<ENV
AWS_REGION=${region}
LOG_GROUP=${log_group}
PUBLIC_URL=$public_url
DB_HOST=${db_host}
DB_PASSWORD=$(ssm db)
REDIS_PASSWORD=$(ssm redis)
KEYCLOAK_ADMIN_PASSWORD=$(ssm keycloak-admin)
KEYCLOAK_BFF_CLIENT_SECRET=$(ssm bff-secret)
KEYCLOAK_INTERNAL_CLIENT_SECRET=$(ssm internal-secret)
KEYCLOAK_ACCOUNT_ADMIN_CLIENT_SECRET=$(ssm account-admin-secret)
APP_IMAGE=${app_image}
GATEWAY_IMAGE=${gateway_image}
SPRING_PROFILES_ACTIVE=${seed_profile}
ENV

%{ if ghcr_username != "" ~}
echo "== Đăng nhập GHCR (image private) =="
ssm ghcr-token | docker login ghcr.io -u "${ghcr_username}" --password-stdin
%{ endif ~}

echo "== Database: schema theo module + database riêng cho Keycloak (như infra/docker-compose/postgres/init) =="
set -a
. "$dir/.env"
set +a
psql() {
  docker run --rm -e PGPASSWORD="$DB_PASSWORD" -e PGSSLMODE=require postgres:17.6 psql -v ON_ERROR_STOP=1 -h "$DB_HOST" -U tickethub "$@"
}
psql -d tickethub -c "CREATE SCHEMA IF NOT EXISTS account; CREATE SCHEMA IF NOT EXISTS catalog; CREATE SCHEMA IF NOT EXISTS booking; CREATE SCHEMA IF NOT EXISTS payment; CREATE SCHEMA IF NOT EXISTS ticket; CREATE SCHEMA IF NOT EXISTS notification; CREATE SCHEMA IF NOT EXISTS shared;"
if [ "$(psql -d tickethub -tAc "SELECT 1 FROM pg_database WHERE datname = 'keycloak'")" != "1" ]; then
  psql -d tickethub -c "CREATE DATABASE keycloak"
fi

echo "== Chạy ứng dụng =="
cd "$dir"
docker compose pull
docker compose up -d
echo "== Xong: $public_url =="
