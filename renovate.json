{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":semanticCommitTypeAll(chore)", ":dependencyDashboard"],
  "timezone": "Asia/Ho_Chi_Minh",
  "schedule": ["before 8am on monday"],
  "prConcurrentLimit": 5,
  "labels": ["dependencies"],
  "packageRules": [
    {
      "description": "Spring Boot và các thư viện đi theo cùng release train: gom một PR, kiểm tay vì dễ vỡ tương thích",
      "matchPackageNames": ["org.springframework.boot:**", "org.springframework.cloud:**", "org.springframework.modulith:**"],
      "groupName": "spring",
      "automerge": false
    },
    {
      "description": "Frontend: gom bản vá / minor của devDependencies",
      "matchManagers": ["npm"],
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "frontend dev dependencies"
    },
    {
      "description": "Orval 8 cần Node >= 22.18 (máy dev đang Node 20): chưa nâng",
      "matchPackageNames": ["orval"],
      "allowedVersions": "<8"
    },
    {
      "description": "Image nền Docker và GitHub Actions: gom theo loại",
      "matchManagers": ["dockerfile", "docker-compose"],
      "groupName": "docker images"
    },
    {
      "matchManagers": ["github-actions"],
      "groupName": "github actions"
    }
  ],
  "vulnerabilityAlerts": { "labels": ["security"], "schedule": ["at any time"] }
}
