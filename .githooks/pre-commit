#!/bin/sh
# Chặn commit chứa secret. Bật một lần: git config core.hooksPath .githooks
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "gitleaks chưa được cài. Cài tại https://github.com/gitleaks/gitleaks rồi commit lại." >&2
  exit 1
fi
exec gitleaks git --pre-commit --staged --redact --verbose
